# JWT Configuration
JWT_SECRET="dev-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30

# API Configuration
API_TITLE="Tourism Middleware API"
API_DESCRIPTION="API documentation for user authentication in the Tourism Middleware project."
API_VERSION="1.0.0"

# Security Configuration
BCRYPT_ROUNDS=12

DOMAIN="http://localhost:8000"

# Logging Configuration
LOG_LEVEL="INFO"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:5174"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Frontend URL
FRONTEND_URL="http://localhost:5173"
VENDOR_PORTAL_URL="http://localhost:5174"

# Email Configuration (Brevo) - placeholder
MAIL_HOST="smtp-relay.brevo.com"
MAIL_PORT=587
MAIL_USERNAME="your-email@smtp-brevo.com"
MAIL_PASSWORD="your-brevo-password"
MAIL_FROM_EMAIL="noreply@dataset.com"
MAIL_FROM_NAME="dataset"
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Storage Configuration - use local for dev
STORAGE_PROVIDER="local"
STORAGE_LOCAL_BASE_DIR="uploads"
STORAGE_LOCAL_PUBLIC_BASE_URL="/uploads"

MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_SECURE=false
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ENABLED=false

# File Upload Configuration
MAX_FILE_SIZE=52428800
MAX_VIDEO_FILE_SIZE=1073741824
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "image/gif", "image/svg+xml", "application/pdf", "video/mp4", "video/avi", "video/mov", "video/wmv", "video/flv", "video/webm"]

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# Infrastructure URLs
API_URL="http://localhost:8000"
DOCS_URL="http://localhost:8000/docs"
REDISINSIGHT_URL="http://localhost:8001"
