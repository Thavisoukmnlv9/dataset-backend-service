# Environment
ENVIRONMENT="development"

# Database Configuration
DATABASE_URL="postgresql://pern:welcome@localhost:5432/dataset"

# Gemini
GEMINI_API_KEY="AIzaSyDUORhtRBnzEhbIgJAPcfNvx5XiZlht12c"

# Qdrant
QDRANT_URL="http://localhost:6333"
