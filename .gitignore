prisma/.pytest_cache/
prisma/migrations/
prisma/node_modules/
app/prisma/generated
node_modules/
package-lock.json
yarn.lock

# Ignore Docker & Deployment Artifacts
docker-compose.override.yml
*.pem

DATABASE_SETUP.md
/app/generated/prisma
otp_codes.txt

# Ignore Deployment Server Configuration (contains sensitive credentials)
infra/deploy/server-config.sh

