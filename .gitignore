# Ignore Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# Ignore Virtual Environment
.venv/
venv/
pyvenv.cfg

# Ignore Environment Variables
.env
*.env

# Ignore Database Files (SQLite example, not needed for PostgreSQL)
*.db
*.sqlite3

# Ignore VS Code & JetBrains IDE settings
.vscode/
.idea/

# Ignore MacOS system files
.DS_Store

# Ignore pytest & Jupyter files
.pytest_cache/
.ipynb_checkpoints/

