generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = "true"
  output                      = "../app/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? @db.VarChar(255)

  // Profile Info
  first_name   String?
  last_name    String?
  nickname     String?
  country_code String?
  avatar_url   String?

  // Account Settings
  language_pref         String    @default("en")
  email_verified        Boolean   @default(false)
  email_verified_at     DateTime?
  phone_number_verified Boolean   @default(false)
  phone_number          String?   @db.VarChar(20)
  theme_pref            String    @default("dark")

  // Social Login
  google_id       String? @unique
  facebook_id     String? @unique
  apple_id        String? @unique
  social_provider String? // google, facebook, apple

  // Security & Activity
  scope                    String?   @db.VarChar(500)
  id_token                 String?   @db.Text
  access_token             String?   @db.Text
  refresh_token            String?   @db.Text
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  last_login_at            DateTime?
  failed_login_attempts    Int       @default(0)
  locked_until             DateTime?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  // Relations
  role           UserRole  @default(STAFF)
  banned         Boolean   @default(false)
  ban_reason     String?   @db.Text
  ban_expires    DateTime?
  is_anonymous   Boolean   @default(false)
  last_logout_at DateTime?
  login_count    Int       @default(0)

  is_active Boolean @default(true)

  refresh_tokens RefreshToken[]
  sessions       Session[]

  @@unique([google_id, facebook_id, apple_id])
  @@index([email])
  @@index([phone_number])
  @@index([role])
  @@index([banned])
  @@index([created_at])
  @@index([deleted_at])
  @@index([is_active, role])
  @@index([email_verified, is_active])
  @@index([last_login_at])
  @@index([failed_login_attempts])
  @@map("users")
}

model Session {
  id                  String   @id @default(uuid())
  expires_at          DateTime
  token               String   @unique @db.VarChar(500)
  session_fingerprint String   @db.VarChar(255)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  ip_address          String?  @db.VarChar(45)
  user_agent          String?  @db.Text
  user_id             String
  impersonated_by     String?
  is_active           Boolean  @default(true)
  device_info         Json?
  last_activity       DateTime @default(now()) 
  is_trusted          Boolean  @default(false) 
  security_level      String   @default("normal") 
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_active])
  @@index([token])
  @@index([session_fingerprint])
  @@index([last_activity])
  @@index([created_at])
  @@index([security_level, is_active])
  @@index([is_trusted, is_active])
  @@map("sessions")
}

model RefreshToken {
  id             String    @id @default(uuid())
  user_id        String
  token_hash     String    @unique @db.VarChar(255)
  expires_at     DateTime
  device_info    Json?
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  is_revoked     Boolean   @default(false)
  revoked_at     DateTime?
  revoked_reason String?   @db.VarChar(100)
  replaced_by_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_revoked])
  @@map("refresh_tokens")
}

model ApiKey {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  key_hash     String    @unique @db.VarChar(255)
  user_id      String?
  permissions  String[]
  expires_at   DateTime?
  is_active    Boolean   @default(true)
  last_used_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@index([user_id])
  @@index([is_active])
  @@index([expires_at])
  @@map("api_keys")
}

model RateLimit {
  id           String    @id @default(uuid())
  identifier   String    @db.VarChar(255)
  endpoint     String    @db.VarChar(255)
  count        Int       @default(1)
  window_start DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@unique([identifier, endpoint, window_start])
  @@index([identifier])
  @@index([endpoint])
  @@index([window_start])
  @@map("rate_limits")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  STAFF
}
