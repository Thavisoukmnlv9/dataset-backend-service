generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = "true"
  output                      = "../app/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? @db.VarChar(255)

  // Profile Info
  first_name   String?
  last_name    String?
  nickname     String?
  country_code String?
  avatar_url   String?

  // Account Settings
  language_pref         String    @default("en")
  email_verified        Boolean   @default(false)
  email_verified_at     DateTime?
  phone_number_verified Boolean   @default(false)
  phone_number          String?   @db.VarChar(20)
  theme_pref            String    @default("dark")

  // Social Login
  google_id       String? @unique
  facebook_id     String? @unique
  apple_id        String? @unique
  social_provider String? // google, facebook, apple

  // Security & Activity
  scope                    String?   @db.VarChar(500)
  id_token                 String?   @db.Text
  access_token             String?   @db.Text
  refresh_token            String?   @db.Text
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  last_login_at            DateTime?
  failed_login_attempts    Int       @default(0)
  locked_until             DateTime?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  // Relations
  role           UserRole  @default(STAFF)
  banned         Boolean   @default(false)
  ban_reason     String?   @db.Text
  ban_expires    DateTime?
  is_anonymous   Boolean   @default(false)
  last_logout_at DateTime?
  login_count    Int       @default(0)

  is_active Boolean @default(true)

  refresh_tokens  RefreshToken[]
  sessions        Session[]
  rbac_user_roles RbacUserRole[]

  @@unique([google_id, facebook_id, apple_id])
  @@index([email])
  @@index([phone_number])
  @@index([role])
  @@index([banned])
  @@index([created_at])
  @@index([deleted_at])
  @@index([is_active, role])
  @@index([email_verified, is_active])
  @@index([last_login_at])
  @@index([failed_login_attempts])
  @@map("users")
}

model Session {
  id                  String   @id @default(uuid())
  expires_at          DateTime
  token               String   @unique @db.VarChar(500)
  session_fingerprint String   @db.VarChar(255)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  ip_address          String?  @db.VarChar(45)
  user_agent          String?  @db.Text
  user_id             String
  impersonated_by     String?
  is_active           Boolean  @default(true)
  device_info         Json?
  last_activity       DateTime @default(now())
  is_trusted          Boolean  @default(false)
  security_level      String   @default("normal")
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_active])
  @@index([token])
  @@index([session_fingerprint])
  @@index([last_activity])
  @@index([created_at])
  @@index([security_level, is_active])
  @@index([is_trusted, is_active])
  @@map("sessions")
}

model RefreshToken {
  id             String    @id @default(uuid())
  user_id        String
  token_hash     String    @unique @db.VarChar(255)
  expires_at     DateTime
  device_info    Json?
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  is_revoked     Boolean   @default(false)
  revoked_at     DateTime?
  revoked_reason String?   @db.VarChar(100)
  replaced_by_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_revoked])
  @@map("refresh_tokens")
}

model ApiKey {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  key_hash     String    @unique @db.VarChar(255)
  user_id      String?
  permissions  String[]
  expires_at   DateTime?
  is_active    Boolean   @default(true)
  last_used_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@index([user_id])
  @@index([is_active])
  @@index([expires_at])
  @@map("api_keys")
}

model RbacRole {
  id             String         @id @default(uuid())
  name           String         @db.VarChar(100)
  description    String?        @db.Text
  permissions    String[]
  role_type      RoleType
  is_active      Boolean        @default(true)
  is_system_role Boolean        @default(false)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?
  user_roles     RbacUserRole[]

  @@index([role_type])
  @@index([is_active])
  @@index([name])
  @@map("rbac_roles")
}

model RbacUserRole {
  id          String    @id @default(uuid())
  user_id     String
  role_id     String
  assigned_by String?
  assigned_at DateTime  @default(now())
  expires_at  DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role        RbacRole  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([role_id])
  @@index([is_active])
  @@index([expires_at])
  @@map("rbac_user_roles")
}

model RateLimit {
  id           String    @id @default(uuid())
  identifier   String    @db.VarChar(255)
  endpoint     String    @db.VarChar(255)
  count        Int       @default(1)
  window_start DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@unique([identifier, endpoint, window_start])
  @@index([identifier])
  @@index([endpoint])
  @@index([window_start])
  @@map("rate_limits")
}

model Restaurant {
  id       String          @id @default(uuid())
  category ListingCategory @default(RESTAURANT)
  name     String
  slug     String          @unique
  status   ListingStatus   @default(ACTIVE)

  // Vendor / contact
  vendor_name         String?
  contact_phone       String?
  whatsapp            String?
  email               String?
  verification_status VerificationStatus?

  short_description String?
  long_description  String?

  country      String
  province     String
  district     String
  village      String?
  address_text String?

  latitude  Float?
  longitude Float?

  price_band PriceBand?
  currency   String?
  min_price  Int?
  max_price  Int?

  booking_supported Boolean @default(false)
  walk_in_supported Boolean @default(true)

  languages_supported String[]

  cover_image_url String?
  rating_avg      Float?
  rating_count    Int     @default(0)

  trust_score      Int?
  quality_score    Int?
  popularity_score Int?

  gallery      RestaurantGalleryImage[]
  tags         RestaurantTag[]
  policies     RestaurantPolicy[]
  translations RestaurantTranslation[]
  hours        RestaurantHours?
  menu         RestaurantMenu?
  details      RestaurantDetails?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([province, district])
  @@index([status])
  @@index([category])
  @@map("restaurants")
}

model RestaurantGalleryImage {
  id            String     @id @default(uuid())
  restaurant_id String
  url           String
  description   String?
  is_cover      Boolean    @default(false)
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@map("restaurant_gallery_images")
}

model RestaurantTag {
  id            String     @id @default(uuid())
  restaurant_id String
  tag_type      TagType
  tag_value     String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([tag_type, tag_value])
  @@map("restaurant_tags")
}

model RestaurantPolicy {
  id            String     @id @default(uuid())
  restaurant_id String
  policy_type   PolicyType
  policy_text   String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([policy_type])
  @@map("restaurant_policies")
}

model RestaurantTranslation {
  id                String     @id @default(uuid())
  restaurant_id     String
  language          String
  name              String?
  short_description String?
  restaurant        Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, language])
  @@index([language])
  @@map("restaurant_translations")
}

model RestaurantHours {
  id              String     @id @default(uuid())
  restaurant_id   String     @unique
  timezone        String?
  weekly_schedule Json
  special_notes   Json? // array of strings
  restaurant      Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("restaurant_hours")
}

model RestaurantMenu {
  id            String @id @default(uuid())
  restaurant_id String @unique

  source_type    String
  source_version String?
  source_url     String?
  language       String?
  extracted_at   DateTime?
  metadata       Json?

  restaurant Restaurant    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  sections   MenuSection[]

  @@index([restaurant_id])
  @@map("restaurant_menus")
}

model MenuSection {
  id          String         @id @default(uuid())
  menu_id     String
  name        String
  source_type String?
  sort_order  Int            @default(0)
  menu        RestaurantMenu @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@index([menu_id])
  @@map("menu_sections")
}

model MenuItem {
  id         String  @id @default(uuid())
  section_id String
  item_id    String?

  name              String
  description       String?
  price             Int?
  currency          String?
  image_url         String[]
  image_description String?
  dietary           Json?
  spice_level       SpiceLevel?
  allergens         String[]
  tags              String[]
  section           MenuSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([section_id])
  @@index([item_id])
  @@map("menu_items")
}

model RestaurantDetails {
  id                     String     @id @default(uuid())
  restaurant_id          String     @unique
  cuisine_types          String[]
  meal_types             String[]
  avg_spend_per_person   Int?
  dietary_options        Json?
  reservation_supported  Boolean    @default(false)
  reservation_required   Boolean    @default(false)
  seating_capacity       Int?
  indoor_seating         Boolean    @default(false)
  outdoor_seating        Boolean    @default(false)
  takeaway_available     Boolean    @default(false)
  delivery_available     Boolean    @default(false)
  payment_methods        String[]
  signature_dishes       String[]
  alcohol_served         Boolean    @default(false)
  parking_available      Boolean    @default(false)
  wifi_available         Boolean    @default(false)
  noise_level            String?
  suitable_for           String[]
  best_time_to_visit     String?
  wait_time_peak_minutes Int?
  restaurant             Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@map("restaurant_details")
}

enum ListingCategory {
  RESTAURANT
  CAFE
  ATTRACTION
  VEHICLE_RENTAL
  BAR
  SOUVENIR
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum PriceBand {
  BUDGET
  LOW
  MID
  HIGH
  PREMIUM
  LUXURY
}

enum TagType {
  VIBE
  THEME
  OCCASION
  FEATURE
  CUISINE
  PURPOSE
  OTHER
}

enum PolicyType {
  CANCELLATION
  DEPOSIT
  RESERVATION
  HOUSE_RULES
  OTHER
}

enum SpiceLevel {
  MILD
  MEDIUM
  HOT
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  STAFF
}

enum RoleType {
  PLATFORM
  ADMIN
  SUPER_ADMIN
  SUPPORT
  RESTAURANT
  VEHICLE_RENTAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Cafe {
  id       String          @id @default(uuid())
  listing_id        String?         @unique @db.VarChar(50)      
  category          ListingCategory @default(CAFE)
  sub_category      String?         @db.VarChar(50)
  name              String
  slug              String          @unique
  status            ListingStatus   @default(ACTIVE)

  vendor_name         String?
  contact_phone       String?
  whatsapp            String?
  email               String?
  verification_status VerificationStatus?

  short_description String?         @db.Text
  long_description  String?         @db.Text

  country      String
  province     String
  district     String
  village      String?
  address_text String? @db.Text
  latitude     Float?
  longitude    Float?

  price_band PriceBand?
  currency   String?    @db.VarChar(10)
  min_price  Int?
  max_price  Int?

  booking_supported Boolean @default(false)
  walk_in_supported Boolean @default(true)

  // Cafe-specific
  instant_confirmation        Boolean  @default(false)
  cancellation_policy_summary String?   @db.Text
  child_friendly              Boolean  @default(false)
  pet_friendly                Boolean  @default(false)
  accessibility_features      Json?
  review_summary_text         String?   @db.Text
  last_verified_at            DateTime?

  languages_supported String[]
  cover_image_url     String?  @db.Text
  rating_avg          Float?
  rating_count        Int     @default(0)
  trust_score         Int?
  quality_score       Int?
  popularity_score    Int?

  gallery      CafeGalleryImage[]
  details      CafeDetails?
  tags         CafeTag[]
  hours        CafeHours?
  policies     CafePolicy[]
  translations CafeTranslation[]
  menu         CafeMenu?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([province, district])
  @@index([slug])
  @@map("cafes")
}

model CafeGalleryImage {
  id         String  @id @default(uuid())
  cafe_id    String
  url        String  @db.Text
  description String?
  is_cover   Boolean  @default(false)
  cafe       Cafe    @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@index([cafe_id])
  @@map("cafe_gallery_images")
}

model CafeDetails {
  id                     String     @id @default(uuid())
  cafe_id                String     @unique
  cuisine_types          String[]
  meal_types            String[]
  avg_spend_per_person   Int?
  dietary_options        Json?
  reservation_supported  Boolean    @default(false)
  reservation_required   Boolean    @default(false)
  seating_capacity       Int?
  indoor_seating         Boolean    @default(false)
  outdoor_seating        Boolean    @default(false)
  takeaway_available     Boolean    @default(false)
  delivery_available     Boolean    @default(false)
  payment_methods        String[]
  signature_dishes       String[]
  alcohol_served         Boolean    @default(false)
  parking_available      Boolean    @default(false)
  wifi_available         Boolean    @default(false)
  noise_level            String?
  suitable_for          String[]
  best_time_to_visit     String?
  wait_time_peak_minutes Int?
  tea_options            String[]
  coffee_styles          String[]
  cafe                   Cafe       @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@index([cafe_id])
  @@map("cafe_details")
}

model CafeTag {
  id        String   @id @default(uuid())
  cafe_id   String
  tag_type  TagType
  tag_value String
  cafe      Cafe     @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@index([cafe_id])
  @@index([tag_type, tag_value])
  @@map("cafe_tags")
}

model CafeHours {
  id              String  @id @default(uuid())
  cafe_id         String  @unique
  timezone        String? @db.VarChar(50)
  weekly_schedule Json
  special_notes   Json?   // array of strings, like RestaurantHours
  cafe            Cafe    @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@map("cafe_hours")
}

model CafeMenu {
  id            String  @id @default(uuid())
  cafe_id       String  @unique
  source_type   String
  source_version String?
  source_url    String?
  language      String?
  extracted_at  DateTime?
  metadata      Json?

  cafe     Cafe             @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
  sections CafeMenuSection[]

  @@index([cafe_id])
  @@map("cafe_menus")
}

model CafeMenuSection {
  id          String       @id @default(uuid())
  menu_id     String
  name        String
  source_type String?
  sort_order  Int          @default(0)
  menu        CafeMenu     @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  items       CafeMenuItem[]

  @@index([menu_id])
  @@map("cafe_menu_sections")
}

model CafeMenuItem {
  id          String         @id @default(uuid())
  section_id  String
  item_id     String?

  name              String
  description       String?
  price             Int?
  currency          String?
  image_url         String[]
  image_description String?
  dietary           Json?
  spice_level       SpiceLevel?
  allergens         String[]
  tags              String[]
  section           CafeMenuSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([section_id])
  @@index([item_id])
  @@map("cafe_menu_items")
}

model CafePolicy {
  id          String     @id @default(uuid())
  cafe_id     String
  policy_type PolicyType
  policy_text String     @db.Text
  cafe        Cafe       @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@index([cafe_id])
  @@index([policy_type])
  @@map("cafe_policies")
}

model CafeTranslation {
  id                String  @id @default(uuid())
  cafe_id           String
  language          String  @db.VarChar(10)
  name              String?
  short_description String?  @db.Text
  long_description  String? @db.Text
  cafe              Cafe    @relation(fields: [cafe_id], references: [id], onDelete: Cascade)

  @@unique([cafe_id, language])
  @@index([language])
  @@map("cafe_translations")
}
