model SouvenirDetails {
  id          String @id @default(uuid())
  souvenir_id String @unique

  shop_type          String? // boutique_shop, local_market_shop, artisan_workshop, museum_shop, etc.
  product_categories String[] // textile, silver, woodcraft, bamboo, pottery, etc.
  specialties        String[] // lao_silk, handmade_scarf, silver_jewelry, etc.

  // Authenticity / local story
  local_made_focus                   Boolean? @default(false)
  handmade_focus                     Boolean? @default(false)
  artisan_direct                     Boolean? @default(false)
  authenticity_claims                String[] // "handmade by local artisans", "100% Lao silk", etc.
  authenticity_certificate_available Boolean? @default(false)
  artisan_story_available            Boolean? @default(false)
  cultural_significance_notes        String?

  origin_regions String[] // Luang Prabang, Xiengkhouang, etc.
  materials_used String[] // silk, silver, bamboo, wood, etc.

  // Shopping services
  customization_available Boolean? @default(false)
  customization_types     String[] // engraving, name_printing, custom_color, custom_size
  customization_notes     String?
  gift_wrapping           Boolean? @default(false)
  bulk_order_supported    Boolean? @default(false)
  wholesale_available     Boolean? @default(false)

  // Shipping / travel-friendly
  shipping_available        Boolean? @default(false)
  local_delivery_available  Boolean? @default(false)
  international_shipping    Boolean? @default(false)
  shipping_notes            String?
  packaging_safe_for_travel Boolean? @default(false)
  fragile_items_available   Boolean? @default(false)

  // Return / exchange (common traveler question)
  return_exchange_supported Boolean? @default(false)
  return_window_days        Int?
  return_notes              String?

  // Pricing guidance (shop-level)
  avg_spend_per_person Int?
  currency             String?
  price_level_notes    String? // "Budget-friendly", "Premium crafts", etc.

  // Convenience
  payment_methods   String[]
  staff_languages   String[] // lo, en, th
  parking_available Boolean? @default(false)
  wifi_available    Boolean? @default(false)
  wheelchair_access Boolean? @default(false)
  air_conditioned   Boolean? @default(false)
  toilet_available  Boolean? @default(false)

  // Experience / discovery
  photo_spot   Boolean? @default(false)
  suitable_for String[] // gifts, business_gifts, collectors, last_minute, etc.
  best_for     String[] // budget_souvenirs, premium_gifts, local_handmade, etc.

  // Timing
  best_time_to_visit     String?
  best_days_to_visit     String[]
  peak_hours             String?
  wait_time_peak_minutes Int?
  queue_expected         Boolean? @default(false)
  queue_peak_minutes     Int?

  souvenir Souvenir @relation(fields: [souvenir_id], references: [id], onDelete: Cascade)

  @@map("souvenir_details")
}

model SouvenirProduct {
  id          String @id @default(uuid())
  souvenir_id String

  // Identity
  product_name      String?
  product_slug      String? @unique
  product_category  String?
  sku               String?
  short_description String?
  long_description  String?

  // Material + origin
  material_type    String?
  material_color   String?
  material_size    String?
  material_weight  String?
  material_shape   String?
  material_texture String?
  origin_region    String?
  origin_country   String?

  // Craft / quality
  is_handmade              Boolean? @default(false)
  artisan_made             Boolean? @default(false)
  authenticity_certificate Boolean? @default(false)
  is_customizable          Boolean? @default(false)
  customization_notes      String?

  // Travel practicality
  packaging_safe_for_travel Boolean? @default(false)
  fragile                   Boolean? @default(false)
  care_instructions         String?

  // Relations
  souvenir Souvenir               @relation(fields: [souvenir_id], references: [id], onDelete: Cascade)
  images   SouvenirProductImage[]

  @@index([souvenir_id])
  @@index([product_category])
  @@map("souvenir_products")
}

model SouvenirProductImage {
  id                  String   @id @default(uuid())
  souvenir_product_id String
  url                 String?
  description         String?
  is_cover            Boolean? @default(false)

  souvenir_product SouvenirProduct @relation(fields: [souvenir_product_id], references: [id], onDelete: Cascade)

  @@index([souvenir_product_id])
  @@map("souvenir_product_images")
}
