generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = "true"
  output                      = "../app/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? @db.VarChar(255)

  // Profile Info
  first_name   String?
  last_name    String?
  nickname     String?
  country_code String?
  avatar_url   String?

  // Account Settings
  language_pref         String    @default("en")
  email_verified        Boolean   @default(false)
  email_verified_at     DateTime?
  phone_number_verified Boolean   @default(false)
  phone_number          String?   @db.VarChar(20)
  theme_pref            String    @default("dark")

  // Social Login
  google_id       String? @unique
  facebook_id     String? @unique
  apple_id        String? @unique
  social_provider String? // google, facebook, apple

  // Security & Activity
  scope                    String?   @db.VarChar(500)
  id_token                 String?   @db.Text
  access_token             String?   @db.Text
  refresh_token            String?   @db.Text
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  last_login_at            DateTime?
  failed_login_attempts    Int       @default(0)
  locked_until             DateTime?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  // Relations
  role           UserRole  @default(STAFF)
  banned         Boolean   @default(false)
  ban_reason     String?   @db.Text
  ban_expires    DateTime?
  is_anonymous   Boolean   @default(false)
  last_logout_at DateTime?
  login_count    Int       @default(0)

  is_active Boolean @default(true)

  refresh_tokens RefreshToken[]
  sessions       Session[]

  @@unique([google_id, facebook_id, apple_id])
  @@index([email])
  @@index([phone_number])
  @@index([role])
  @@index([banned])
  @@index([created_at])
  @@index([deleted_at])
  @@index([is_active, role])
  @@index([email_verified, is_active])
  @@index([last_login_at])
  @@index([failed_login_attempts])
  @@map("users")
}

model Session {
  id                  String   @id @default(uuid())
  expires_at          DateTime
  token               String   @unique @db.VarChar(500)
  session_fingerprint String   @db.VarChar(255)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  ip_address          String?  @db.VarChar(45)
  user_agent          String?  @db.Text
  user_id             String
  impersonated_by     String?
  is_active           Boolean  @default(true)
  device_info         Json?
  last_activity       DateTime @default(now()) 
  is_trusted          Boolean  @default(false) 
  security_level      String   @default("normal") 
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_active])
  @@index([token])
  @@index([session_fingerprint])
  @@index([last_activity])
  @@index([created_at])
  @@index([security_level, is_active])
  @@index([is_trusted, is_active])
  @@map("sessions")
}

model RefreshToken {
  id             String    @id @default(uuid())
  user_id        String
  token_hash     String    @unique @db.VarChar(255)
  expires_at     DateTime
  device_info    Json?
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  is_revoked     Boolean   @default(false)
  revoked_at     DateTime?
  revoked_reason String?   @db.VarChar(100)
  replaced_by_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_revoked])
  @@map("refresh_tokens")
}

model ApiKey {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  key_hash     String    @unique @db.VarChar(255)
  user_id      String?
  permissions  String[]
  expires_at   DateTime?
  is_active    Boolean   @default(true)
  last_used_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@index([user_id])
  @@index([is_active])
  @@index([expires_at])
  @@map("api_keys")
}

model RateLimit {
  id           String    @id @default(uuid())
  identifier   String    @db.VarChar(255)
  endpoint     String    @db.VarChar(255)
  count        Int       @default(1)
  window_start DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@unique([identifier, endpoint, window_start])
  @@index([identifier])
  @@index([endpoint])
  @@index([window_start])
  @@map("rate_limits")
}

model Restaurant {
  id               String         @id
  category         ListingCategory @default(restaurant)
  name             String
  slug             String         @unique
  status           ListingStatus  @default(active)

  shortDescription String?
  longDescription  String?

  country          String
  province         String
  district         String
  village          String?
  addressText      String?

  latitude         Float?
  longitude        Float?

  priceBand        PriceBand?
  currency         String?        // keep flexible (e.g., "LAK")
  minPrice         Int?
  maxPrice         Int?

  bookingSupported Boolean        @default(false)
  walkInSupported  Boolean        @default(true)

  languagesSupported LanguageCode[]

  coverImageUrl    String?
  ratingAvg        Float?
  ratingCount      Int            @default(0)

  trustScore       Int?
  qualityScore     Int?
  popularityScore  Int?

  gallery          RestaurantGalleryImage[]
  tags             RestaurantTag[]
  policies         RestaurantPolicy[]
  translations     RestaurantTranslation[]
  hours            RestaurantHours?
  menu             RestaurantMenu?
  details          RestaurantDetails?

  createdAt        DateTime
  updatedAt        DateTime       @updatedAt

  @@index([province, district])
  @@index([status])
  @@index([category])
}

model RestaurantGalleryImage {
  id           String     @id @default(cuid())
  restaurantId String
  url          String
  description  String?

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model RestaurantTag {
  id           String     @id @default(cuid())
  restaurantId String
  tagType      TagType
  tagValue     String

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tagType, tagValue])
}

model RestaurantPolicy {
  id           String     @id @default(cuid())
  restaurantId String
  policyType   PolicyType
  policyText   String

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([policyType])
}

model RestaurantTranslation {
  id           String       @id @default(cuid())
  restaurantId String
  language     LanguageCode

  name             String?
  shortDescription String?

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, language])
  @@index([language])
}

model RestaurantHours {
  id            String     @id @default(cuid())
  restaurantId  String     @unique
  weeklySchedule Json
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantMenu {
  id            String     @id @default(cuid())
  restaurantId  String     @unique

  sourceType    String
  sourceVersion String?
  sourceUrl     String?
  language      LanguageCode?
  extractedAt   DateTime?
  metadata      Json?

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sections      MenuSection[]

  @@index([restaurantId])
}

model MenuSection {
  id        String         @id @default(cuid())
  menuId    String
  name      String
  sortOrder Int            @default(0)

  menu      RestaurantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id              String      @id @default(cuid())
  sectionId        String
  itemId           String?     // keeps your "menu_001" etc (external id)

  name             String
  description      String?
  price            Int?
  currency         String? 
  imageUrl         String?
  imageDescription String?
  dietary          Json?
  spiceLevel       SpiceLevel?
  allergens        String[]    // e.g. ["fish_sauce", "peanut"]
  tags             String[]    // e.g. ["dip", "local"]
  section          MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  @@index([sectionId])
  @@index([itemId])
}

model RestaurantDetails {
  id                  String     @id @default(cuid())
  restaurantId        String     @unique
  cuisineTypes        String[]
  mealTypes           String[]
  avgSpendPerPerson   Int?
  dietaryOptions      Json?
  reservationSupported Boolean   @default(false)
  reservationRequired  Boolean   @default(false)
  seatingCapacity     Int?
  indoorSeating       Boolean    @default(false)
  outdoorSeating      Boolean    @default(false)
  takeawayAvailable   Boolean    @default(false)
  deliveryAvailable   Boolean    @default(false)
  paymentMethods      String[]
  signatureDishes     String[]
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  @@index([restaurantId])
}


enum ListingCategory {
  restaurant
  cafe
  attraction
  vehicle_rental
  bar
  souvenir
}

enum ListingStatus {
  active
  inactive
  draft
  archived
}

enum PriceBand {
  budget
  mid
  premium
  luxury
}

enum TagType {
  vibe
  theme
  occasion
  feature
  cuisine
  other
}

enum PolicyType {
  cancellation
  deposit
  reservation
  other
}

enum LanguageCode {
  lo
  en
  th
}

enum SpiceLevel {
  mild
  medium
  hot
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  STAFF
}
